# Supabase público
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública nova, do painel em Settings > API Keys.
# As chaves legacy (anon, JWT começando com "eyJ") foram desativadas:
# usá-las devolve "Legacy API keys are disabled" em toda query.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA

# Apenas no servidor. Nunca use NEXT_PUBLIC_ nesta variável.
# Substitui a antiga SUPABASE_SERVICE_ROLE_KEY (também JWT).
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA
